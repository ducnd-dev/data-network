# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SUPPORT_EMAIL=support@data-network.app

# Supabase (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Azure Document Intelligence (https://portal.azure.com)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Cloudflare R2 (https://dash.cloudflare.com)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_KEY_PREFIX=documents
NEXT_PUBLIC_R2_PUBLIC_URL=

# Polar (https://polar.sh)
POLAR_ACCESS_TOKEN=
POLAR_SERVER=sandbox
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_ID_PRO_MONTHLY=
POLAR_PRODUCT_ID_BUSINESS_MONTHLY=

# OpenAI (classification + general extraction)
OPENAI_API_KEY=
OCR_CLASSIFY_MODEL=gpt-4o-mini
OCR_EXTRACT_MODEL=gpt-4o-mini

# Unit economics (AUD) — tune for margin tracking
OCR_AZURE_PAGE_COST_AUD=0.015
OCR_LLM_CLASSIFY_COST_AUD=0.002
OCR_LLM_EXTRACT_COST_AUD=0.003
OCR_COST_SAFETY_FACTOR=1.2

# Vercel Cron
CRON_SECRET=

# Database migrations (optional — for npm run db:migrate)
DATABASE_URL=

# Seed admin (npm run db:seed)
# SEED_ADMIN_EMAIL=admin@data-network.app
# SEED_ADMIN_PASSWORD=DataNetworkAdmin2026!
# SEED_ADMIN_NAME=Workspace Admin
# SEED_ORG_NAME=My Organisation
# SEED_ORG_PLAN=business

# Cloud auto-setup (npm run db:setup:cloud) — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_NAME=data-network
SUPABASE_REGION=ap-southeast-2
# SUPABASE_ORG_ID=   # optional; defaults to first org
